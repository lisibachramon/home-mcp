# ---------------------------------------------------------------------------
# home-mcp configuration. Copy to .env and edit. NEVER commit your real .env.
#
# In the CI deploy (.github/workflows/deploy.yml) this .env is rendered from
# GitHub repo secrets and scp'd to the server — you don't hand-edit it there.
# This file documents every knob for local runs and for reference.
# ---------------------------------------------------------------------------

# REQUIRED. The bearer token Claude must present. Generate a strong one with:
#   python scripts/gen_token.py
# (Use HOME_MCP_TOKENS=a,b,c to allow several tokens, e.g. during rotation.)
HOME_MCP_TOKEN=replace-me-with-a-long-random-secret

# --- Reverse proxy (jwilder/nginx-proxy + letsencrypt-companion) ------------
# docker-compose.yml sets VIRTUAL_HOST/LETSENCRYPT_HOST from HOME_MCP_DOMAIN and
# joins the external `proxy_default` network, so your existing nginx-proxy routes
# https://HOME_MCP_DOMAIN -> this container and the companion issues the cert.
HOME_MCP_DOMAIN=mcp.example.com
LETSENCRYPT_EMAIL=you@example.com

# Pinned image (CI sets this to the exact commit SHA). Defaults to :latest.
# HOME_MCP_IMAGE=ghcr.io/lisibachramon/home-mcp:latest

# --- Network (inside the container) -----------------------------------------
# Bind all interfaces so nginx-proxy can reach it on the proxy network.
# HOME_MCP_HOST=0.0.0.0
# HOME_MCP_PORT=8848
# HOME_MCP_PATH=/mcp
# JSON responses (default true) sit better behind nginx than SSE streaming.
# HOME_MCP_JSON_RESPONSE=true
# Trust X-Forwarded-For/X-Real-IP from the proxy (default true).
# HOME_MCP_TRUST_PROXY=true

# Optional source-IP allowlist (comma-separated IPs/CIDRs). Great with a VPN:
# HOME_MCP_IP_ALLOWLIST=100.64.0.0/10,192.168.0.0/16

# --- Deploys ----------------------------------------------------------------
# Named compose projects Claude may deploy. JSON or name=path,name2=path2.
# Paths must be valid INSIDE the container (mounted at matching host paths).
# HOME_MCP_PROJECTS={"shorts":"/srv/stacks/shorts","blog":"/srv/stacks/blog"}
# Host directory mounted into the container by docker-compose.yml (STACKS_DIR).
# STACKS_DIR=/srv/stacks
# Allow deploys against ANY directory path, not just named projects (default false).
# HOME_MCP_ALLOW_ANY_PATH=false

# --- Safety -----------------------------------------------------------------
# Refuse to stop/remove the server's own container (default true).
# HOME_MCP_PROTECT_SELF=true
# Disable whole capability groups if you don't want them.
# HOME_MCP_ENABLE_DOCKER=true
# HOME_MCP_ENABLE_COMPOSE=true
# HOME_MCP_ENABLE_GH=true

# --- GitHub CLI -------------------------------------------------------------
# gh authenticates from the environment. Use a fine-grained PAT scoped to the
# repos you want Claude to manage. (Or mount ~/.config/gh — see docker-compose.yml.)
# GH_TOKEN=github_pat_xxx

# --- Logging ----------------------------------------------------------------
# HOME_MCP_LOG_LEVEL=info
# HOME_MCP_AUDIT_LOG=/var/log/home-mcp/audit.log
